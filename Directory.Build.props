<Project>
  <PropertyGroup>
    <!-- Reproducible restores across CI/Docker/local (security residual). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <!-- Pin vulnerable transitive dependencies to patched versions -->
  <ItemGroup>
    <!-- NU1903: 10.0.9 GHSA advisories — pin patched 10.0.10 (PrivateAssets: avoid NU1510 prune noise) -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <!-- Latest 2.x. Microsoft.AspNetCore.OpenApi 10.0.11 constrains OpenApi to >=2.7.5 && <3.0.0.
         3.x still fails XmlCommentGenerator (CS0200 IOpenApiMediaType.Example). Evidence: openapi3-fail.log. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
  </ItemGroup>
</Project>
