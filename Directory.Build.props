<Project>
  <PropertyGroup>
    <!-- Reproducible restores across CI/Docker/local (security residual). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <!-- Pin vulnerable transitive dependencies to patched versions -->
  <ItemGroup>
    <!-- NU1903: 10.0.9 GHSA advisories — pin patched 10.0.10 (PrivateAssets: avoid NU1510 prune noise) -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <!-- GHSA-v5pm-xwqc-g5wc: Microsoft.OpenApi &lt;= 2.7.4 / &lt;= 3.5.3 stack-overflow on circular refs -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>
</Project>
